# ----------------------------------------------------------------------------
# Environment variables for the portfolio.
# Copy this file to `.env.local` and adjust as needed. Nothing here is secret —
# it only affects how static URLs are generated.
# ----------------------------------------------------------------------------

# Base path for GitHub Pages PROJECT sites served from a sub-path,
# e.g. https://<username>.github.io/portfolio  ->  set this to "/portfolio".
#
# Leave it EMPTY (or unset) for:
#   - Vercel
#   - a custom domain
#   - a GitHub Pages USER/ORG site (https://<username>.github.io)
#
# The GitHub Actions workflow sets this automatically based on the repo name,
# so you usually only need this for local testing of the sub-path build.
NEXT_PUBLIC_BASE_PATH=
